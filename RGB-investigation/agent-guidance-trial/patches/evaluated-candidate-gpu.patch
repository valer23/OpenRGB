+
+bool GalaxGPUv1Controller::GetEXGamerColors(unsigned char* rgb)
+{
+    return(bus->i2c_smbus_read_i2c_block_data(dev, GALAX_V1_RED_REGISTER, 3, rgb) == 3);
+}
+
+bool GalaxGPUv1Controller::DisableEXGamerSync()
+{
+    /*-----------------------------------------------------*\
+    | Retry only this observed, intermittently failing      |
+    | transition. Never re-enable sync after a colour frame.|
+    \*-----------------------------------------------------*/
+    sync_attempted = true;
+    for(unsigned int attempt = 0; attempt < 3; attempt++)
+    {
+        std::this_thread::sleep_for(std::chrono::milliseconds(200));
+        int result = bus->i2c_smbus_write_byte_data(dev, GALAX_EX_GAMER_SYNC_REGISTER, 0x00);
+        std::this_thread::sleep_for(std::chrono::milliseconds(200));
+        int sync = bus->i2c_smbus_read_byte_data(dev, GALAX_EX_GAMER_SYNC_REGISTER);
+        if(result == 0 && sync == 0)
+        {
+            sync_disabled = true;
+            return(true);
+        }
+    }
+
+    LOG_WARNING("[%s] Could not confirm motherboard sync disabled; reselect Direct or Static to retry", name.c_str());
+    return(false);
+}
+
+void GalaxGPUv1Controller::BeginEXGamerMode()
+{
+    sync_attempted = false;
+    sync_disabled  = false;
+}
+
+bool GalaxGPUv1Controller::WriteEXGamerColor(unsigned char red, unsigned char green, unsigned char blue)
+{
+    unsigned char rgb[3] = { red, green, blue };
+    int result = bus->i2c_smbus_write_i2c_block_data(dev, GALAX_V1_RED_REGISTER, 3, rgb);
+    std::this_thread::sleep_for(std::chrono::milliseconds(25));
+    if(result != 0)
+    {
+        return(false);
+    }
+    result = bus->i2c_smbus_write_byte_data(dev, GALAX_V1_MODE_REGISTER_1, GALAX_V1_MODE_STATIC_VALUE_1);
+    std::this_thread::sleep_for(std::chrono::milliseconds(25));
+    if(result != 0)
+    {
+        return(false);
+    }
+    result = bus->i2c_smbus_write_byte_data(dev, GALAX_V1_MODE_REGISTER_2, GALAX_EX_GAMER_STATIC_VALUE_2);
+    std::this_thread::sleep_for(std::chrono::milliseconds(25));
+    if(result != 0)
+    {
+        return(false);
+    }
+    result = bus->i2c_smbus_write_byte_data(dev, GALAX_EX_GAMER_APPLY_REGISTER, GALAX_EX_GAMER_APPLY_VALUE);
+    std::this_thread::sleep_for(std::chrono::milliseconds(25));
+    return(result == 0);
+}
+
+void GalaxGPUv1Controller::SetEXGamerColors(unsigned char red, unsigned char green, unsigned char blue)
+{
+    if(!sync_attempted)
+    {
+        DisableEXGamerSync();
+    }
+    if(!sync_disabled)
+    {
+        return;
+    }
+
+    bool success = WriteEXGamerColor(red, green, blue);
+    if(!success && !color_failed)
+    {
+        LOG_WARNING("[%s] Static colour transfer failed; remaining commands skipped", name.c_str());
+    }
+    color_failed = !success;
