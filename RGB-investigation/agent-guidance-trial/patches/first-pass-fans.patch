+bool RGBController_LianLiUniHubSLInfinity::ConfigureChannel(unsigned int channel)
+{
+    /*-----------------------------------------------------*\
+    | Centre and side channels share a physical fan count.  |
+    | Round partial fan groups up and use the larger zone.  |
+    \*-----------------------------------------------------*/
+    unsigned int first = (channel / 2) * 2;
+    unsigned int count = zones[first].leds_count;
+    if(zones[first + 1].leds_count > count)
+    {
+        count = zones[first + 1].leds_count;
+    }
+
+    return controller->SendStartAction((unsigned char)channel, (count + 15) / 16);
+}
