+unsigned int RGBController_LianLiUniHubSLInfinity::GetPortFanCount(unsigned int channel)
+{
+    /*---------------------------------------------------------*\
+    | Centres and sides share one physical port fan count.     |
+    \*---------------------------------------------------------*/
+    unsigned int first = (channel / 2) * 2;
+    unsigned int count = zones[first].leds_count;
+    if(zones[first + 1].leds_count > count)
+    {
+        count = zones[first + 1].leds_count;
+    }
+    return (count + 15) / 16;
+}
