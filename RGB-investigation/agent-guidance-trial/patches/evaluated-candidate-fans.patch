+bool LianLiUniHubSLInfinityController::CheckReport(int result, unsigned int expected, unsigned char channel)
+{
+    if(result != (int)expected)
+    {
+        if(!report_error_logged[channel])
+        {
+            LOG_WARNING("[Lian Li Uni Hub - SL Infinity] Lighting report failed or short (%d, expected %u)", result, expected);
+            report_error_logged[channel] = true;
+        }
+        return false;
+    }
+    return true;
+}
+
+bool LianLiUniHubSLInfinityController::SendStartAction(unsigned char channel, unsigned int num_fans)
+{
+    if(channel >= UNIHUB_SLINF_CHANNEL_COUNT || num_fans == 0 || num_fans > 6)
+    {
+        return false;
+    }
+
+    if(!lighting_sync_disabled)
+    {
+        unsigned char sync_buf[7] = { UNIHUB_SLINF_TRANSACTION_ID, 0x10, 0x61, 0x00, 0x00, 0x00, 0x00 };
+        bool success = CheckReport(hid_send_feature_report(dev, sync_buf, sizeof(sync_buf)), sizeof(sync_buf), channel);
+        WaitForReport(20);
+        if(!success)
+        {
+            return false;
+        }
+        lighting_sync_disabled = true;
+    }
+
+    unsigned int port = channel / 2;
+    if(configured_fans[port] == (int)num_fans)
+    {
+        return true;
+    }
+
+    unsigned char usb_buf[7] = { UNIHUB_SLINF_TRANSACTION_ID, 0x10, 0x60, (unsigned char)(port + 1), (unsigned char)num_fans, 0x00, 0x00 };
+    bool success = CheckReport(hid_send_feature_report(dev, usb_buf, sizeof(usb_buf)), sizeof(usb_buf), channel);
+    WaitForReport(5);
+    if(success)
+    {
+        configured_fans[port] = num_fans;
+    }
+    return success;
+}
