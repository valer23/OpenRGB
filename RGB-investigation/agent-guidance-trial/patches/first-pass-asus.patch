+/*---------------------------------------------------------*\
+| AsusROGLogoControllerDetect_Windows.cpp                   |
+|                                                           |
+|   ASUS ROG STRIX B850-F GAMING WIFI7 NEO logo              |
+|                                                           |
+|   OpenRGB contributors                       15 Oct 2026 |
+|                                                           |
+|   This file is part of the OpenRGB project                |
+|   SPDX-License-Identifier: GPL-2.0-or-later               |
+\*---------------------------------------------------------*/
+
+#include "DetectionManager.h"
+#include "AsusROGLogoController_Windows.h"
+#include "RGBController_AsusROGLogo_Windows.h"
+
+#define ASUS_ROG_LOGO_VID 0x0B05
+#define ASUS_ROG_LOGO_PID 0x1CD2
+
+DetectedControllers DetectAsusROGLogo(hid_device_info* info, const std::string& /*name*/)
+{
+    DetectedControllers detected_controllers;
+    hid_device*         dev = hid_open_path(info->path);
+
+    if(dev)
+    {
+        AsusROGLogoController*     controller     = new AsusROGLogoController(dev, info->path);
+        RGBController_AsusROGLogo* rgb_controller = new RGBController_AsusROGLogo(controller);
+
+        detected_controllers.push_back(rgb_controller);
+    }
+
+    return(detected_controllers);
+}
+
+REGISTER_HID_DETECTOR_IPU("ASUS ROG STRIX B850-F GAMING WIFI7 NEO Logo", DetectAsusROGLogo, ASUS_ROG_LOGO_VID, ASUS_ROG_LOGO_PID, 1, 0xFF0A, 0x0001);
