+
+#include <chrono>
+#include <thread>
+#include "AsusROGLogoController_Windows.h"
+#include "LogManager.h"
+
+AsusROGLogoController::AsusROGLogoController(hid_device* dev_handle, const char* path)
+{
+    dev             = dev_handle;
+    location        = path;
+    initialized     = false;
+    transfer_failed = false;
+}
+
+AsusROGLogoController::~AsusROGLogoController()
+{
+    hid_close(dev);
+}
+
+std::string AsusROGLogoController::GetDeviceLocation()
+{
+    return("HID: " + location);
+}
+
+bool AsusROGLogoController::SendReport(const unsigned char* report)
+{
+    /*-----------------------------------------------------*\
+    | The capture uses control SET_REPORT, not hid_write.   |
+    | The 64 bytes include report ID 0x41.                  |
+    \*-----------------------------------------------------*/
+    int result = hid_send_output_report(dev, report, ASUS_ROG_LOGO_REPORT_SIZE);
+
+    std::this_thread::sleep_for(std::chrono::milliseconds(30));
+
+    if(result != ASUS_ROG_LOGO_REPORT_SIZE)
+    {
+        initialized = false;
+
+        if(!transfer_failed)
+        {
+            LOG_WARNING("[ASUS ROG Logo] Control output report failed or short (%d/64); a later update can retry", result);
+        }
+
+        transfer_failed = true;
+        return(false);
+    }
+
+    return(true);
+}
+
+bool AsusROGLogoController::Initialize()
+{
+    /*-----------------------------------------------------*\
+    | These are the two observed onboard output selectors. |
+    | Their independent physical mapping is unknown.        |
+    \*-----------------------------------------------------*/
+    for(unsigned char output = 0; output < 2; output++)
+    {
+        unsigned char report[ASUS_ROG_LOGO_REPORT_SIZE] = {};
+
+        report[0] = 0x41;
+        report[1] = 0x05;
+        report[2] = 0x01;
+        report[6] = output;
+        report[8] = 0x01;
+
+        if(!SendReport(report))
+        {
+            return(false);
+        }
+    }
+
+    std::this_thread::sleep_for(std::chrono::milliseconds(2200));
+
+    /*-----------------------------------------------------*\
+    | This packet restored response in capture replay.     |
+    | Its wider meaning is unknown.                        |
+    \*-----------------------------------------------------*/
+    unsigned char report[ASUS_ROG_LOGO_REPORT_SIZE] = {};
+
+    report[0] = 0x41;
+    report[1] = 0x21;
+    report[3] = 0x01;
+
+    if(!SendReport(report))
+    {
+        return(false);
+    }
+
+    std::this_thread::sleep_for(std::chrono::milliseconds(1000));
+    initialized = true;
+    return(true);
+}
+
+void AsusROGLogoController::SetColor(RGBColor color)
+{
+    /*-----------------------------------------------------*\
+    | Initialize on the first update, never at detection.   |
+    | No immediate retries: abort on any failed report.     |
+    | A later update restarts initialization for recovery.  |
+    \*-----------------------------------------------------*/
+    if(!initialized && !Initialize())
+    {
+        return;
+    }
+
+    for(unsigned char output = 0; output < 2; output++)
+    {
+        unsigned char report[ASUS_ROG_LOGO_REPORT_SIZE] = {};
+
+        report[0]  = 0x41;
+        report[1]  = 0x05;
+        report[2]  = 0x01;
+        report[6]  = output;
+        report[16] = 0x01;
+        report[18] = RGBGetGValue(color);
+        report[19] = RGBGetRValue(color);
+        report[20] = RGBGetBValue(color);
+
+        if(!SendReport(report))
+        {
+            return;
+        }
+    }
+
+    /*-----------------------------------------------------*\
+    | Clear the diagnostic latch only after a full update.  |
+    | API success does not establish physical confirmation. |
+    \*-----------------------------------------------------*/
+    transfer_failed = false;
+}
