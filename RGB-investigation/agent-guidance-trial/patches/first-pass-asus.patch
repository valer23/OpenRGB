+\*---------------------------------------------------------*/
+
+#include "RGBController_AsusROGLogo_Windows.h"
+
+/**------------------------------------------------------------------*\
+    @name ASUS ROG STRIX B850-F GAMING WIFI7 NEO Logo
+    @category Motherboard
+    @type USB
+    @save :x:
+    @direct :white_check_mark:
+    @effects :x:
+    @detectors DetectAsusROGLogo
+    @comment Windows only. Logo only; ASUS LightingService must not
+        control lighting concurrently. ARGB headers are not supported.
+\*-------------------------------------------------------------------*/
+
+RGBController_AsusROGLogo::RGBController_AsusROGLogo(AsusROGLogoController* controller_ptr)
+{
+    controller                  = controller_ptr;
+    name                        = "ASUS ROG STRIX B850-F GAMING WIFI7 NEO Logo";
+    vendor                      = "ASUS";
+    type                        = DEVICE_TYPE_MOTHERBOARD;
+    description                 = "ASUS onboard ROG logo";
+    location                    = controller->GetDeviceLocation();
+
+    mode Direct;
+    Direct.name                 = "Direct";
+    Direct.value                = 0;
+    Direct.flags                = MODE_FLAG_HAS_PER_LED_COLOR;
+    Direct.color_mode           = MODE_COLORS_PER_LED;
+    modes.push_back(Direct);
+
+    SetupZones();
+}
+
+RGBController_AsusROGLogo::~RGBController_AsusROGLogo()
+{
+    Shutdown();
+    delete controller;
+}
+
+void RGBController_AsusROGLogo::SetupZones()
+{
+    /*-----------------------------------------------------*\
+    | Both observed outputs receive the same colour.       |
+    | Replay observations justify only one combined logo.  |
+    \*-----------------------------------------------------*/
+    zone logo;
+    logo.name                   = "ROG Logo";
+    logo.type                   = ZONE_TYPE_SINGLE;
+    logo.leds_min               = 1;
+    logo.leds_max               = 1;
+    logo.leds_count             = 1;
+    zones.push_back(logo);
+
+    led logo_led;
+    logo_led.name               = "ROG Logo";
+    leds.push_back(logo_led);
+
+    SetupColors();
+}
+
+void RGBController_AsusROGLogo::DeviceUpdateLEDs()
+{
+    controller->SetColor(colors[0]);
+}
+
+void RGBController_AsusROGLogo::DeviceUpdateZoneLEDs(int /*zone*/)
+{
+    DeviceUpdateLEDs();
+}
+
+void RGBController_AsusROGLogo::DeviceUpdateSingleLED(int /*led*/)
+{
+    DeviceUpdateLEDs();
+}
+
+void RGBController_AsusROGLogo::DeviceUpdateMode()
+{
+    DeviceUpdateLEDs();
+}
