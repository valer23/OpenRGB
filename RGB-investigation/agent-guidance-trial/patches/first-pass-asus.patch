+#include <string>
+#include "RGBController.h"
+
+#define ASUS_ROG_LOGO_REPORT_SIZE 64
+
+class AsusROGLogoController
+{
+public:
+    AsusROGLogoController(hid_device* dev_handle, const char* path);
