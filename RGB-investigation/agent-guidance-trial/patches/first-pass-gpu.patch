 #include "pci_ids.h"
 #include "RGBController_GalaxGPUv1.h"
 #include "RGBController_GalaxGPUv2.h"
+
+DetectedControllers DetectGalaxEXGamerGPUController(i2c_smbus_interface* bus, uint8_t i2c_addr, const std::string& name)
+{
+    DetectedControllers detected_controllers;
+    unsigned char signature[I2C_SMBUS_BLOCK_MAX];
+    unsigned char rgb[I2C_SMBUS_BLOCK_MAX];
+
+    /*-----------------------------------------------------*\
+    | PCI IDs are shared with the Founders Edition. Require |
+    | the observed signature and a complete RGB read. Sync |
+    | readback is unreliable and is not an identity check. |
+    \*-----------------------------------------------------*/
+    if(bus->i2c_smbus_read_i2c_block_data(i2c_addr, 0x00, 2, signature) == 2 &&
+       signature[0] == 0x11 && signature[1] == 0x00 &&
+       bus->i2c_smbus_read_i2c_block_data(i2c_addr, GALAX_V1_RED_REGISTER, 3, rgb) == 3)
+    {
+        GalaxGPUv1Controller* controller = new GalaxGPUv1Controller(bus, i2c_addr, name, true);
+        detected_controllers.push_back(new RGBController_GalaxGPUv1(controller));
+    }
+
+    return(detected_controllers);
+}
+
+REGISTER_I2C_PCI_DETECTOR("KFA2 GeForce RTX 3080 Ti EX Gamer", DetectGalaxEXGamerGPUController, NVIDIA_VEN, NVIDIA_RTX3080TI_DEV, NVIDIA_SUB_VEN, NVIDIA_RTX3080TI_FE_SUB_DEV, 0x23);
 
 bool TestForGalaxGPUController(i2c_smbus_interface* bus, unsigned char address)
 {
