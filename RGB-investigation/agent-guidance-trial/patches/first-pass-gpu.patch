+
+/*---------------------------------------------------------*\
+| EX Gamer uses the v1 register layout with an apply command |
+| and a different static-mode value.                        |
+\*---------------------------------------------------------*/
+bool GalaxGPUv1Controller::IsEXGamer()
+{
+    return(ex_gamer);
+}
+
+bool GalaxGPUv1Controller::GetLEDColors(unsigned char* rgb)
+{
+    return(bus->i2c_smbus_read_i2c_block_data(dev, GALAX_V1_RED_REGISTER, 3, rgb) == 3);
+}
+
+bool GalaxGPUv1Controller::SetEXGamerSync(unsigned char value)
+{
+    for(unsigned int attempt = 0; attempt < 3; attempt++)
+    {
+        int result = bus->i2c_smbus_write_byte_data(dev, GALAX_V1_EX_GAMER_SYNC_REGISTER, value);
+        std::this_thread::sleep_for(std::chrono::milliseconds(200));
+
+        /*-------------------------------------------------*\
+        | Only proceed after a successful confirmed write.  |
+        \*-------------------------------------------------*/
+        int sync = bus->i2c_smbus_read_byte_data(dev, GALAX_V1_EX_GAMER_SYNC_REGISTER);
+        if(result == 0 && sync == value)
+        {
+            return(true);
+        }
+    }
+
+    return(false);
+}
+
+bool GalaxGPUv1Controller::WriteEXGamerColor(unsigned char red, unsigned char green, unsigned char blue)
+{
+    unsigned char rgb[3] = { red, green, blue };
+
+    if(!SetEXGamerSync(0x00))
+    {
+        return(false);
+    }
+
+    if(bus->i2c_smbus_write_i2c_block_data(dev, GALAX_V1_RED_REGISTER, 3, rgb) != 0)
+    {
+        return(false);
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(25));
+
+    if(bus->i2c_smbus_write_byte_data(dev, GALAX_V1_MODE_REGISTER_1, GALAX_V1_MODE_STATIC_VALUE_1) != 0)
+    {
+        return(false);
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(25));
+
+    if(bus->i2c_smbus_write_byte_data(dev, GALAX_V1_MODE_REGISTER_2, GALAX_V1_EX_GAMER_STATIC_VALUE_2) != 0)
+    {
+        return(false);
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(25));
+
+    if(bus->i2c_smbus_write_byte_data(dev, GALAX_V1_EX_GAMER_APPLY_REGISTER, GALAX_V1_EX_GAMER_APPLY_VALUE) != 0)
+    {
+        return(false);
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(25));
+
+    return(SetEXGamerSync(0x01));
+}
+
+bool GalaxGPUv1Controller::SetEXGamerColors(unsigned char red, unsigned char green, unsigned char blue)
+{
+    bool success = WriteEXGamerColor(red, green, blue);
+
+    if(!success && !update_failed)
+    {
+        LOG_WARNING("[%s] EX Gamer colour update failed", name.c_str());
+    }
+    update_failed = !success;
+
+    return(success);
+}
