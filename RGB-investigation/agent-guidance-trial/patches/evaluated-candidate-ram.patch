diff --git a/i2c_smbus/Windows/i2c_smbus_pawnio.cpp b/i2c_smbus/Windows/i2c_smbus_pawnio.cpp
--- a/i2c_smbus/Windows/i2c_smbus_pawnio.cpp
+++ b/i2c_smbus/Windows/i2c_smbus_pawnio.cpp
@@ -47,9 +47,38 @@
     HRESULT         status;
 
     /*-----------------------------------------------------*\
-    | Execute PIIX4 port_sel ioctl                          |
-    \*-----------------------------------------------------*/
-    status = pawnio_execute(pawnio_handle, "ioctl_piix4_port_sel", in, in_size, out, 1, &return_size);
+    | Serialize port selection with other SMBus users       |
+    \*-----------------------------------------------------*/
+    HANDLE smbus_mutex = CreateMutexA(NULL, FALSE, GLOBAL_SMBUS_MUTEX_NAME);
+
+    if(smbus_mutex == NULL)
+    {
+        LOG_ERROR("PawnIO PIIX4 port %d: failed to create SMBus mutex", port);
+        return(-EIO);
+    }
+
+    DWORD wait_status = WaitForSingleObject(smbus_mutex, INFINITE);
+
+    if(wait_status != WAIT_OBJECT_0 && wait_status != WAIT_ABANDONED)
+    {
+        LOG_ERROR("PawnIO PIIX4 port %d: failed to acquire SMBus mutex", port);
+        CloseHandle(smbus_mutex);
+        return(-EIO);
+    }
+
+    /*-----------------------------------------------------*\
+    | Execute PIIX4 port_sel ioctl while owning the mutex   |
+    | WAIT_ABANDONED also grants ownership                  |
+    \*-----------------------------------------------------*/
+    status = pawnio_execute(pawnio_handle, "ioctl_piix4_port_sel", in, in_size, out, out_size, &return_size);
+
+    if(!ReleaseMutex(smbus_mutex))
+    {
+        LOG_ERROR("PawnIO PIIX4 port %d: failed to release SMBus mutex", port);
+        status = E_FAIL;
+    }
+
+    CloseHandle(smbus_mutex);
 
     return(status ? -EIO : 0);
 }
