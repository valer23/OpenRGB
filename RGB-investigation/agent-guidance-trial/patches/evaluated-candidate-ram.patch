-
-        bus = new i2c_smbus_pawnio(pawnio_handle, "piix4_0", 0);
-        DetectionManager::get()->RegisterI2CBus(bus);
+        if(piix4_port_sel(pawnio_handle, 0) == 0)
+        {
+            bus = new i2c_smbus_pawnio(pawnio_handle, "piix4_0", 0);
+            DetectionManager::get()->RegisterI2CBus(bus);
+            bus_detected = true;
+        }
+        else
+        {
+            LOG_WARNING("PawnIO PIIX4 port 0 selection failed, skipping bus");
+
+            if(pawnio_close(pawnio_handle))
+            {
+                LOG_ERROR("PawnIO failed to close");
+            }
+        }
     }
 
